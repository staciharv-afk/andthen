# And Then — environment configuration
# Copy this file to `.env` and fill in the real values from the Supabase
# dashboard: Project Settings → API. The `.env` file is gitignored.

# Project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Public "anon" key (a valid JWT — three dot-separated segments).
# Settings → API → Project API keys → "anon" "public".
VITE_SUPABASE_ANON_KEY=

# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX.
# GA4 admin → Admin (gear icon) → Data Streams → your web stream → Measurement ID.
# Only loads in production builds — never on `npm run dev` — even if set.
VITE_GA_MEASUREMENT_ID=

# Stripe publishable key (starts pk_live_… in production, pk_test_… for
# testing) — safe to expose client-side, unlike STRIPE_SECRET_KEY.
# Stripe Dashboard → Developers → API keys → Publishable key.
# Powers the embedded checkout in src/lib/stripe.js.
VITE_STRIPE_PUBLISHABLE_KEY=
